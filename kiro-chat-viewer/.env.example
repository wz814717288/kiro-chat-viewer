# Kiro Chat Viewer 可选环境变量(复制为 .env 或在启动前 export)
# 所有变量都有默认值,通常无需设置。

# Kiro 数据根目录(默认 ~/.kiro)。数据在别处时用它指定。
# KIRO_HOME=/path/to/.kiro

# 服务监听地址与端口(默认 127.0.0.1:8765)。仅本机访问,勿改为 0.0.0.0 暴露到网络。
# KCV_HOST=127.0.0.1
# KCV_PORT=8765

# 索引数据库路径(默认 data/index.db)
# KCV_DB=/path/to/index.db

# Kiro API key(ksk_)。也可在网页「设置」里配置(推荐)。用于 kiro-cli 自动生成画像。
# KIRO_API_KEY=ksk_xxxxxxxx

# 可选:OpenAI 兼容 LLM(如本地 Ollama),用于单会话分析的自动生成
# KCV_LLM_API_BASE=http://127.0.0.1:11434/v1
# KCV_LLM_API_KEY=ollama
# KCV_LLM_MODEL=qwen2.5:7b
